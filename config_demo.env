# Copy this file to config.env and replace the placeholder values.
# Never commit config.env or real credentials.

# OpenAI-compatible model config
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-api-key

# ChatGLM model config
GLM_API_KEY=replace-with-your-chatglm-api-key
GLM_SECRET=replace-with-your-chatglm-secret

# Dify config
DIFY_API_KEY=replace-with-your-dify-api-key
DIFY_API_HOST=http://localhost/v1
DIFY_CONSOLE_HOST=http://localhost/console/api
